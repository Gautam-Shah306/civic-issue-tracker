{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-issue-tracker.local/contracts/events/user.updated.v1.schema.json",
  "title": "UserUpdatedV1",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "user.updated"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "userId",
            "changedBy",
            "changes",
            "updatedAt"
          ],
          "properties": {
            "userId": {
              "type": "string",
              "format": "uuid"
            },
            "changedBy": {
              "type": "string",
              "format": "uuid"
            },
            "changes": {
              "type": "object",
              "properties": {
                "isActive": {
                  "type": "boolean"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "citizen",
                    "officer",
                    "admin"
                  ]
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
