{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-issue-tracker.local/contracts/events/user.created.v1.schema.json",
  "title": "UserCreatedV1",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "properties": {
        "eventType": {
          "const": "user.created"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userId",
            "email",
            "displayName",
            "role",
            "createdAt"
          ],
          "properties": {
            "userId": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "role": {
              "type": "string",
              "enum": [
                "citizen",
                "officer",
                "admin"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}
