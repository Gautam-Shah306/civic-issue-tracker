{
  "name": "@civic-issue-tracker/report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "openapi:write": "tsc && node dist/openapi-write.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "rabbitmq-client": "5.0.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/rabbitmq": "12.2.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
